{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "typescript",
    "oxc",
    "import",
    "promise"
  ],
  "categories": {
    "correctness": "error",
    "perf": "error",
    "suspicious": "warn",
  },
  "rules": {
    "no-await-in-loop": "off",
    "eslint/no-underscore-dangle": "off",
    "oxc/no-async-endpoint-handlers": "off",
    "typescript/no-unsafe-type-assertion": "off",
  },
  "env": {
    "builtin": true
  },
  "options": {
    "typeAware": true
  },
}