# Port for local dev (Vercel ignores this)
PORT=3000

# Comma-separated list of allowed origins, e.g. http://localhost:5173,https://app.example.com
# Empty = CORS disabled
CORS_ORIGIN=http://localhost:5173

# MongoDB connection for the business API
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=blarescape

# Required for routes marked admin and for includeFlagged=true
ADMIN_API_TOKEN=replace-with-a-long-random-token
