Project SoundScape {
  database_type: 'MongoDB'
  Note: 'Initial schema for the SoundScape noise pollution API. Paste this file into dbdiagram.io to render the diagram. Field details: docs/database-schema.md'
}

Enum noise_source {
  traffic
  construction
  nightlife
  industry
  aircraft
  other
}

Enum site_type {
  school
  hospital
  kindergarten
  care_home
}

Table contributors {
  _id objectid [pk]
  anonymousDeviceId string [unique, not null, note: 'Random ID generated by the client app; no personal data']
  displayName string
  readingsCount int [not null, default: 0]
  createdAt datetime [not null]
}

Table neighborhoods {
  _id objectid [pk]
  name string [not null]
  slug string [unique, not null]
  city string [not null]
  boundary geojson_polygon [not null, note: 'GeoJSON Polygon or MultiPolygon; 2dsphere index']
}

Table noise_readings {
  _id objectid [pk]
  contributorId objectid [not null]
  neighborhoodId objectid [note: 'Resolved by the server from location; null outside known neighborhoods']
  location geojson_point [not null, note: '[longitude, latitude]; 2dsphere index']
  decibelLevel double [not null, note: 'dB(A), accepted range 0-140']
  recordedAt datetime [not null, note: 'Device time (UTC)']
  receivedAt datetime [not null, note: 'Server time (UTC)']
  noiseSource noise_source
  measurementDurationSeconds int
  isFlagged boolean [not null, default: false]

  Indexes {
    (neighborhoodId, recordedAt)
    (contributorId, recordedAt)
  }
}

Table sensitive_sites {
  _id objectid [pk]
  neighborhoodId objectid [not null]
  name string [not null]
  siteType site_type [not null]
  location geojson_point [not null, note: '2dsphere index']
  protectionRadiusMeters double [not null, default: 200]
}

Ref: noise_readings.contributorId > contributors._id
Ref: noise_readings.neighborhoodId > neighborhoods._id
Ref: sensitive_sites.neighborhoodId > neighborhoods._id
